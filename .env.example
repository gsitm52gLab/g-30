# Optional: no API key is required for G00/G01. Never commit real credentials.
DATA_SOURCE=mock
DATABASE_FILE=.local/data/gs-hale.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
# Must match the browser origin; every worktree uses an isolated namespace.
APP_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_NAME=gs_hale_3000
