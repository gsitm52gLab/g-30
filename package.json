{
  "name": "gs-hale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:mock": "cross-env DATA_SOURCE=mock next dev --hostname 127.0.0.1",
    "dev:db": "cross-env DATA_SOURCE=sqlite next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src scripts tests next.config.ts playwright.config.ts vitest.config.ts *.mjs --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:db": "cross-env E2E_DATA_SOURCE=sqlite playwright test",
    "test:install": "playwright install chromium",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:setup": "tsx scripts/db.ts setup",
    "db:restart": "tsx scripts/verify-restart.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "verify": "npm run check && npm run build && npm run db:restart && npm run test:e2e && npm run test:e2e:db"
  },
  "dependencies": {
    "@next/env": "16.3.5",
    "better-sqlite3": "13.0.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
