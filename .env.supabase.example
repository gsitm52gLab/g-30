# Supabase server configuration for the async app repository.
# Never copy this file over an existing .env. Fill secrets only in untracked env files.
# Apply explicit migrations and full synthetic seed before selecting this mode.
DATA_SOURCE=supabase
DATABASE_URL=
# Migration-only connection; use the provider's session pooler/direct URI.
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=gs-hale-private
APP_ORIGIN=https://g-30-pi.vercel.app
SESSION_COOKIE_NAME=gs_hale
# Preserve the existing server-side OpenAI configuration; do not copy secrets here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
